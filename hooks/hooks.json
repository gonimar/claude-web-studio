{
  "hooks": {
    "SessionStart": [{ "matcher": "", "hooks": [
      { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start.sh", "timeout": 10 } ] }],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/validate-commit.sh", "timeout": 20 },
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/validate-push.sh", "timeout": 10 } ] },
      { "matcher": "Write|Edit", "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/secret-guard.sh", "timeout": 10 } ] }
    ],
    "PostToolUse": [{ "matcher": "Write|Edit", "hooks": [
      { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/post-edit-check.sh", "timeout": 60 },
      { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/validate-skill-change.sh", "timeout": 5 } ] }],
    "Notification": [{ "matcher": "", "hooks": [
      { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/notify.sh", "timeout": 10 } ] }],
    "PreCompact": [{ "matcher": "", "hooks": [
      { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/pre-compact.sh", "timeout": 10 } ] }],
    "Stop": [{ "matcher": "", "hooks": [
      { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-stop.sh", "timeout": 10 } ] }],
    "SubagentStart": [{ "matcher": "", "hooks": [
      { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/log-agent.sh", "timeout": 5 } ] }],
    "SubagentStop": [{ "matcher": "", "hooks": [
      { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/log-agent.sh", "timeout": 5 } ] }]
  }
}
